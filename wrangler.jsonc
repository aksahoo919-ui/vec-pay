{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vec-pay",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",

  // The React site (built into ./dist) is served as static files.
  // Only /api/* requests run the Worker code.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vec-pay-db",
      // Paste the Database ID from Cloudflare dashboard → Storage & Databases → D1
      "database_id": "5ba46d55-0db3-4f2d-a0ec-589cf8bc3614",
      "migrations_dir": "migrations"
    }
  ],

  // Keep variables/secrets set in the Cloudflare dashboard when deploying.
  "keep_vars": true,

  // Request logs in the Cloudflare dashboard (Workers → vec-pay → Logs)
  "observability": { "enabled": true }
}
